## Version 2026/10/18
# Tubesy behind SWAG (linuxserver/swag)
#
# 1. Tubesy and SWAG must share a Docker network (swag_default), see docs/en/reverse-proxy.md.
# 2. Copy this file to  <swag-config>/nginx/proxy-confs/tubesy.subdomain.conf
# 3. Add the subdomain "tubesy" in SWAG (SUBDOMAINS=...,tubesy) or use a wildcard certificate.
# 4. Restart SWAG:  docker restart swag
#
# Then reachable at https://tubesy.<your-domain>
# WebSocket headers, Host and X-Forwarded-* are already set by SWAG's proxy.conf.

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name tubesy.*;

    include /config/nginx/ssl.conf;

    client_max_body_size 1m;

    # Optional: extra protection with Authelia/Authentik (Tubesy has its own logins).
    #include /config/nginx/authelia-server.conf;

    location / {
        #include /config/nginx/authelia-location.conf;

        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app tubesy;
        set $upstream_port 8080;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
