# Copy to .env and adjust: cp .env.example .env

# Folder on the server where the videos are saved
DOWNLOAD_PATH=./downloads
# Database and cache (small, an SSD is nice)
CONFIG_PATH=./config

# Output of `id <user>` on the server (Synology: usually PUID=1026, PGID=100)
PUID=1000
PGID=1000

# Your time zone, e.g. Europe/London or Europe/Berlin
TZ=Etc/UTC
TUBESY_PORT=8080
# latest (newest stable version), a fixed version like 1.0.0, or edge (development state)
TUBESY_VERSION=latest

YTDLP_AUTO_UPDATE=true
# Network the reverse proxy comes from; the default covers all Docker networks
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Optional: create the administrator directly (otherwise the setup wizard on first visit)
ADMIN_USERNAME=
ADMIN_PASSWORD=
