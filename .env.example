# Kopieren nach .env und anpassen: cp .env.example .env

# Ordner auf der NAS, in den die Videos geschrieben werden
DOWNLOAD_PATH=/volume1/downloads/tubesy
# Datenbank und Cache (klein, gerne auf SSD)
CONFIG_PATH=./config

# Ausgabe von `id <benutzer>` auf der NAS (Synology: meist PUID=1026, PGID=100)
PUID=1000
PGID=1000

TZ=Europe/Berlin
TUBESY_PORT=8080
# latest, oder eine feste Version wie 1.0.0
TUBESY_VERSION=latest

YTDLP_AUTO_UPDATE=true
# Hinter Reverse-Proxy: dessen IP/Netz, z. B. 172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: Admin direkt anlegen (sonst Einrichtungsassistent beim ersten Aufruf)
ADMIN_USERNAME=
ADMIN_PASSWORD=
